includes:
	- phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src/
    bootstrapFiles:
        - vendor/autoload.php
    ignoreErrors:
        - '#Call to an undefined method Doctrine\\ORM\\EntityRepository::findOneBy#'
        -
            message: '#Call to an undefined method Symfony\\Component\\Config\\Definition\\Builder\\NodeDefinition::getChildNodeDefinitions\(\).#'
            path: src/Config/Model/ContentExtension.php
            reportUnmatched: false
        -
            message: '#Call to an undefined method Symfony\\Component\\Config\\Definition\\Builder\\NodeParentInterface::scalarNode\(\).#'
            path: src/Config/Model/ContentExtension.php
            reportUnmatched: false
        -
            message: '#Call to an undefined method Symfony\\Component\\Config\\Definition\\Builder\\NodeParentInterface::end\(\).#'
            path: src/Config/Model/ContentExtension.php
            reportUnmatched: false
